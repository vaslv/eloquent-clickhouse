{
    "name": "timeleads/eloquent-clickhouse",
    "description": "Laravel Eloquent driver for ClickHouse",
    "type": "library",
    "license": "MIT",
    "version": "1.1.0",
    "authors": [
        {
            "name": "Andrei Vasilev",
            "email": "andrei@vaslv.ru"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0|^13.0",
        "smi2/phpclickhouse": "^1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Timeleads\\EloquentClickHouse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Timeleads\\EloquentClickHouse\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Timeleads\\EloquentClickHouse\\ServiceProvider"
            ]
        }
    }
}
