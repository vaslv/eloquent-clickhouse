{
    "name": "vaslv/eloquent-clickhouse",
    "description": "Laravel Eloquent driver for ClickHouse",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrei Vasilev",
            "email": "andrei@vaslv.ru"
        }
    ],
    "support": {
        "issues": "https://github.com/vaslv/eloquent-clickhouse/issues",
        "source": "https://github.com/vaslv/eloquent-clickhouse",
        "security": "https://github.com/vaslv/eloquent-clickhouse/security/policy"
    },
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0|^13.0",
        "smi2/phpclickhouse": "^1.6"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "vaslv/composer-release": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "Vaslv\\EloquentClickHouse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaslv\\EloquentClickHouse\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:all": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaslv\\EloquentClickHouse\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "vaslv/composer-release": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
